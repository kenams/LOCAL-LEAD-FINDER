NETLIFY_DEPLOY_POLL_ATTEMPTS=12
NETLIFY_DEPLOY_POLL_INTERVAL=3
SEARCH_QUERIES_PER_COMBO=8
SEARCH_MAX_RAW_CANDIDATES=24
SEARCH_FALLBACK_ENABLED=true
SEARCH_BROADEN_IF_EMPTY=true
SEARCH_RESET_BEFORE_COLLECT=true
