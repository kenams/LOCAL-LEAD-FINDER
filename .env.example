AUTO_MODE_LIMIT=10
AUTO_MODE_LANGUAGE=fr
AUTO_MODE_SMS_ENABLED=false
AUTO_MODE_REQUIRE_EMAIL_AND_PHONE=false
AUTO_MODE_CONTACT_CANDIDATE_MULTIPLIER=12
AUTO_MODE_MIN_OPPORTUNITY_SCORE=70
AUTO_MODE_GENERATE_MOCKUPS=false
AUTO_MODE_DEPLOY_MOCKUPS=false

# Export
