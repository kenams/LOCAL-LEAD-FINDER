# Application settings
APP_ENV=development
APP_PORT=8000
STREAMLIT_PORT=8501

# Database
DATABASE_URL=sqlite:///./data/local_lead_finder.db

# Default settings
DEFAULT_LANGUAGE=fr
DEFAULT_PROSPECTS_PER_LOCATION=10
REQUIRE_WEBSITE=true
REQUIRE_CONTACT=true
PRIORITY_NICHES_ENABLED=true
EMAIL_ONLY_OUTREACH=true

# API Keys (optional)
SERPAPI_KEY=
APIFY_TOKEN=
NETLIFY_TOKEN=
NETLIFY_API_BASE=https://api.netlify.com/api/v1

# Request settings
REQUEST_TIMEOUT=30
